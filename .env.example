# Docker Compose 2.30+; literal values, no surrounding quotes (raw env_file).
NETBIRD_URL=https://netbird.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_AUTH=true
SMTP_USERNAME=alerts@example.com
SMTP_FROM=alerts@example.com
SMTP_FROM_NAME=NetBird
SMTP_TO=admin@example.com
ALERT_USER_PENDING_APPROVAL=true
ALERT_USER_JOINED=true
ALERT_SERVICE_USER_CREATED=true
ALERT_PEER_ADDED=true
POLL_INTERVAL_SECONDS=60
NETWORK_TIMEOUT_SECONDS=20
MAX_ALERTS_PER_POLL=20
STATE_NAMESPACE=default
# Compose reads passwords/tokens from secrets/*.txt, not from this file.
# SMTP_SECURITY=ssl for TLS from connection start, typically port 465.
# For a trusted plaintext relay only: SMTP_SECURITY=none, SMTP_AUTH=false,
# empty SMTP_USERNAME, empty SMTP password file, ALLOW_INSECURE_SMTP=true.
# Optional custom CA bundles (also mount the files read-only in Compose):
# NETBIRD_CA_FILE=/certs/netbird-ca.pem
# SMTP_CA_FILE=/certs/smtp-ca.pem
